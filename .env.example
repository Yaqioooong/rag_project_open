# DeepSeek OpenAI-compatible chat model
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Alibaba Cloud/DashScope embedding API used by SemanticChunker
ALIBABA_API_KEY=your_alibaba_api_key
ALIBABA_BASE_URL=https://your-dashscope-endpoint.example.com/compatible-mode/v1
ALIBABA_EMBEDDING_MODEL=qwen3.7-text-embedding-flash

# Tavily web search
TAVILY_API_KEY=your_tavily_api_key

# Milvus Lite (local file) or a Milvus server URI
MILVUS_LITE_URI=./db/milvus_demo.db
MILVUS_URI=http://127.0.0.1:19530
COLLECTION_NAME=t_collection01

# Optional embedding settings
BGE_MODEL_NAME=BAAI/bge-small-zh-v1.5
BGE_DEVICE=cpu
